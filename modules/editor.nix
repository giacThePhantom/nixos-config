# Neovim, the editor. Its configuration is not here: ~/.config/nvim is its
# own git repository, in Lua, with plugins pinned by Neovim's vim.pack, so
# the same clone works on machines without Nix (the cluster). This module
# only gives Neovim what it expects from the system: the desktop's palette,
# and the tools its plugins call. Language servers for project languages
# come from each project's environment (dvt), not from here.
{ config, ... }:
let
  c = config.colors;
in
{
  flake.modules.homeManager.editor =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    {
      programs.neovim = {
        enable = true;
        defaultEditor = true;
        viAlias = true;
        vimAlias = true;
        # On Neovim's PATH only, not the shell's
        extraPackages = with pkgs; [
          # nvim-treesitter compiles its grammars on this machine (already
          # in the system as other packages' dependencies)
          tree-sitter
          gcc
          # Language servers and formatters for this repository's own
          # languages; projects bring theirs
          nixd
          bash-language-server
          shellcheck
          shfmt
          nixfmt
        ];
      };

      # The colour scheme reads this when it exists (mini.base16's slots),
      # and falls back to Neovim's default elsewhere. ~/.local/share/nvim/site
      # is on Neovim's runtimepath, so `require("nixos_palette")` finds it.
      xdg.dataFile."nvim/site/lua/nixos_palette.lua".text = ''
        -- Generated by ~/.config/nixos (modules/editor.nix): the desktop's palette
        return {
          base00 = "#${c.bgCard}", base01 = "#${c.bgTertiary}",
          base02 = "#${c.bgSecondary}", base03 = "#${c.textMuted}",
          base04 = "#${c.textMutedStrong}", base05 = "#${c.textSecondary}",
          base06 = "#${c.text}", base07 = "#${c.text}",
          base08 = "#${c.dangerText}", base09 = "#${c.warning}",
          base0A = "#${c.warningText}", base0B = "#${c.successText}",
          base0C = "#${c.info}", base0D = "#${c.infoText}",
          base0E = "#${c.accentLight}", base0F = "#${c.accent}",
        }
      '';

      # ~/.config/nvim belongs to its repository: nothing from here may
      # write into it (home-manager would replace the files with links).
      # programs.neovim always writes an init.lua turning off the Python,
      # Ruby, Node and Perl plugin hosts; the repository's options.lua does it.
      xdg.configFile."nvim/init.lua".enable = lib.mkForce false;
      assertions = [
        {
          assertion =
            !lib.any (f: f.enable && lib.hasPrefix ".config/nvim/" f.target) (
              lib.attrValues config.xdg.configFile
            );
          message = "~/.config/nvim is its own repository: put Neovim settings there, not in Nix";
        }
      ];
    };
}
