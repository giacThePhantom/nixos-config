;; Calendar (Super+C): clock, month, and the next 7 days of renCal events.
;; Events come from renCal's calendars via `dash-agenda`; clicking one opens it in renCal.

(defpoll cal_time :interval "1s" :run-while {panel == "calendar"} :initial "" `date +%H:%M`)
(defpoll cal_date :interval "60s" :run-while {panel == "calendar"} :initial "" `date '+%A, %-d %B'`)
(defpoll agenda :interval "60s" :run-while {panel == "calendar"} :initial "[]" `dash-agenda`)

(defwidget calendar-panel []
  (card :title "Calendar" :key "C"
    (hero :value cal_time :detail cal_date)
    (box :space-evenly false :spacing 24
      (box :class "month" :valign "start" (calendar :show-details false))
      (box :class "agenda" :orientation "v" :space-evenly false :spacing 12 :hexpand true
        (section :text "UPCOMING")
        (label :class "empty" :halign "start" :visible {arraylength(agenda) == 0}
          :text "Nothing in the next 7 days")
        (scroll :vscroll true :hscroll false :height 260
          (box :orientation "v" :space-evenly false :spacing 14
            (for day in agenda
              (box :orientation "v" :space-evenly false :spacing 6
                (label :class "day" :halign "start" :text {day.label})
                (for ev in {day.events}
                  (event :ev ev))))))))
    (box :class "actions" :halign "end"
      (button :class "action" :onclick "dash-run rencal" "󰏌  Open renCal"))))

(defwidget event [ev]
  (button :class "event" :onclick "dash-run xdg-open '${ev.url}'" :tooltip {ev.location}
    (box :space-evenly false :spacing 10
      (box :class "event-bar cal-${ev.cal}" :width 3)
      (box :orientation "v" :space-evenly false
        (label :class "event-title" :halign "start" :limit-width 34 :text {ev.title})
        (label :class "event-time" :halign "start" :text {ev.time})))))
